// Timeline / Tweets partial
.timeline
  position: relative
  margin: 1.5rem 0
  padding-left: 2.25rem

  &:before
    content: ''
    position: absolute
    left: 1rem
    top: 0
    bottom: 0
    width: 2px
    background: $color-border
    opacity: .6
    z-index: 0

.timeline-item
  position: relative
  z-index: 1

.timeline-body
  position: relative
  z-index: 3
  color: $color-text !important

.timeline-group
  margin-bottom: 1.5rem

.timeline-date
  font-weight: 700
  color: $color-meta
  margin-bottom: .6rem
  font-size: .95rem

.timeline-items
  margin: 0
  padding: 0

.timeline-item
  position: relative
  margin-bottom: 1rem
  padding: .6rem 1rem .6rem 0
  display: flex
  align-items: flex-start

  .timeline-body
    margin-left: 1.2rem
    color: $color-text
    line-height: 1.5
    background: fade($color-background, 6%)
    border: 1px solid fade($color-border, 85%)
    border-radius: 8px
    padding: .6rem .9rem
    box-shadow: 0 1px 0 rgba(0,0,0,0.06)
    transition: transform .12s ease, box-shadow .12s ease

// Compact items when content is simple
.timeline-body p
  margin: 0

@media (max-width: 640px)
  .timeline
    padding-left: 1.8rem
    &:before
      left: .75rem

  .timeline-body
    margin-left: 1rem
    padding: .45rem .75rem

// subtle animation
.timeline-item
  opacity: 0
  transform: translateY(6px)
  transition: opacity .25s ease, transform .25s ease

.timeline-item.in-view
  opacity: 1
  transform: none
